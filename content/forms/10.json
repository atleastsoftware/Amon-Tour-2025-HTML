{
  "id": 10,
  "name": "Create Your Custom Trip",
  "title": "Create Your Custom Trip",
  "subtitle": "Your travel story starts with your dreams – let us write the rest.",
  "description": "Tell us what you'd like to discover, and we'll create your personalized itinerary.",
  "headerImage": "/catamaran-cruise.png",
  "layout": "single-column",
  "formLayout": "columns",
  "colors": {
    "backgroundColor": "hsl(var(--background))",
    "primaryColor": "#084F6E",
    "textColor": "#030303",
    "frameColor": "#ffffff",
    "titleColor": "#ffffff",
    "subtitleColor": "#ffffff"
  },
  "fields": [
    {
      "id": "fullName",
      "type": "text",
      "label": "Full Name ",
      "style": {
        "width": "half",
        "marginBottom": 16
      },
      "required": true,
      "placeholder": "Your name"
    },
    {
      "id": "email",
      "type": "email",
      "label": "Email",
      "style": {
        "width": "half",
        "marginBottom": 16
      },
      "required": true,
      "placeholder": "Your email"
    },
    {
      "id": "countrycode",
      "type": "select",
      "label": "Country Code",
      "style": {
        "width": "third",
        "marginBottom": 16
      },
      "options": [
        "🇫🇷 +33",
        "🇹🇭 +66",
        "🇺🇸 +1",
        "🇬🇧 +44",
        "🇩🇪 +49",
        "🇪🇸 +34"
      ],
      "required": false,
      "placeholder": "Code"
    },
    {
      "id": "whatsappNumber",
      "type": "phone",
      "label": "WhatsApp Number",
      "style": {
        "width": "twothirds",
        "marginBottom": 16
      },
      "required": true,
      "placeholder": "Your WhatsApp number"
    },
    {
      "id": "numberOfAdults",
      "type": "select",
      "label": "Number of adults",
      "style": {
        "width": "half",
        "marginBottom": 16
      },
      "options": [
        "1 adult",
        "2 adults",
        "3 adults",
        "4 adults",
        "5 adults",
        "6+ adults"
      ],
      "required": false,
      "placeholder": "Select number of adults"
    },
    {
      "id": "numberOfKids",
      "type": "select",
      "label": "Number of kids (under 12 years old)",
      "style": {
        "width": "half",
        "marginBottom": 16
      },
      "options": [
        "No kids",
        "1 kid",
        "2 kids",
        "3 kids",
        "4 kids",
        "5+ kids"
      ],
      "required": false,
      "placeholder": "Select number of kids"
    },
    {
      "id": "tripDates",
      "type": "date",
      "label": "Dates of trip",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "required": false,
      "placeholder": "Select trip dates"
    },
    {
      "id": "duration",
      "type": "select",
      "label": "Or approximate duration",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "options": [
        "1-3 days",
        "4-7 days",
        "8-14 days",
        "15+ days"
      ],
      "required": false,
      "placeholder": "Select duration"
    },
    {
      "id": "tripTypes",
      "type": "checkbox",
      "label": "Trip Types",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "options": [
        "Culture & History",
        "Nature & Adventure",
        "Beaches & Islands",
        "Family trip",
        "Group trip",
        "Wedding & Honeymoon"
      ],
      "required": false
    },
    {
      "id": "destinations",
      "type": "checkbox",
      "label": "Destinations",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "options": [
        "Khao Sok",
        "Krabi",
        "Koh Mook",
        "Bangkok",
        "Chiang Mai",
        "Others destinations"
      ],
      "required": false
    },
    {
      "id": "message",
      "type": "textarea",
      "label": "Describe your ideal trip",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "required": true,
      "placeholder": "Tell us what you would like to see and do during your journey..."
    }
  ],
  "settings": {
    "errorMessage": "There was a problem sending your request. Please try again.",
    "successMessage": "Thank you! We will contact you very soon to discuss your travel project.",
    "submitButtonText": "Send my request",
    "emailNotification": true,
    "submitButtonColor": "hsl(var(--primary))",
    "whatsappButtonText": "Or contact us directly via WhatsApp",
    "whatsappButtonEnabled": false
  },
