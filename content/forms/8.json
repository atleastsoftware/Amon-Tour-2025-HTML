        "1 day",
        "2 days",
        "3-4 days",
        "5-6 days",
        "7 days and more"
      ],
      "required": true,
      "placeholder": "Choose a duration"
    },
    {
      "id": "message",
      "type": "textarea",
      "label": "Preferred Dates (Optional)",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "required": false,
      "placeholder": "Ex: January 15-20, 2025"
    },
    {
      "id": "field_1760538055472_601m4mrk9",
      "type": "textarea",
      "label": "Preferred Destinations (Optional) Ex: Koh Phi Phi, Koh Hong...",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "required": false,
      "placeholder": "Ex: Koh Phi Phi, Koh Hong..."
    },
    {
      "id": "field_1760538069884_u83xvw5m0",
      "type": "textarea",
      "label": "Special Requests (Optional)",
      "style": {
        "width": "full",
        "marginBottom": 16
      },
      "required": false,
      "placeholder": "Dietary requirements, birthday celebration, etc."
    }
