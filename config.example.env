# Tour Ninja Configuration
# Copy this file to .env and fill in your actual values

# Tour Ninja API Credentials (required for external tours integration)
TOUR_NINJA_API_KEY=your_api_key_here
TOUR_NINJA_COMPANY_ID=your_company_id_here

# Company Configuration
COMPANY_NAME=Amon Tour
COMPANY_DOMAIN=localhost
ALLOWED_DOMAINS=localhost,127.0.0.1,yourdomain.com

# Session Configuration (optional)
SESSION_SECRET=your_secure_session_secret_here

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name