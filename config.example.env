# Tour Ninja Configuration
# Copy this file to .env and fill in your actual values

# Tour Ninja API Credentials (required for external tours integration)
TOUR_NINJA_API_KEY=your_api_key_here
TOUR_NINJA_COMPANY_ID=your_company_id_here

# Optional versioned Tour Ninja presentation releases. This is disabled unless
# explicitly set to true. URLs must be HTTPS and return the proposed
# tourninja-release/v1 JSON documented in docs/TOUR_NINJA_RELEASES.md.
TOUR_NINJA_RELEASES_ENABLED=false
TOUR_NINJA_RELEASES_URL=https://your-controlled-release-host.example/releases/live.json
# Optional bearer credential for the configured release host. Never expose it
# to the browser; do not put a real value in this example file.
TOUR_NINJA_RELEASES_TOKEN=
# Draft preview is admin-session-only and requires a distinct configured URL.
TOUR_NINJA_DRAFT_RELEASE_URL=https://your-controlled-release-host.example/releases/draft.json
# Optional bounded server snapshot cache; defaults to 60, accepted 10..3600.
TOUR_NINJA_RELEASES_CACHE_SECONDS=60

# Company Configuration
COMPANY_NAME=Amon Tour
COMPANY_DOMAIN=localhost
ALLOWED_DOMAINS=localhost,127.0.0.1,yourdomain.com

# Session Configuration (optional)
SESSION_SECRET=your_secure_session_secret_here

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name